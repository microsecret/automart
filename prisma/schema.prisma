// Prisma Schema for AutoRent Markt
// Defines the data models for vehicles, parts, users, listings, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model for authentication and user profiles

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  emailVerified      DateTime?
  name               String?
  image              String? // URL to user's avatar
  phone              String?   @unique
  telegramId         String?   @unique
  telegramUsername   String?
  telegramVerifiedAt DateTime?
  role               String    @default("USER") // USER, ADMIN, MODERATOR
  accountStatus      String    @default("ACTIVE") // ACTIVE, RESTRICTED, BANNED
  restrictionReason  String?
  statusUpdatedAt    DateTime?
  hashedPassword     String?

  // Напоминания о незавершённой регистрации: когда отправили последнее и
  // сколько всего. Нужны, чтобы не писать человеку бесконечно.
  savedSearches    SavedSearch[]
  regReminderAt    DateTime?
  regReminderCount Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  vehicles                      Vehicle[]                      @relation("UserVehicles")
  parts                         Part[]                         @relation("UserParts")
  listings                      Listing[]
  favoriteListings              Listing[]                      @relation("Favorites")
  partBids                      PartBid[]
  reviews                       Review[]                       @relation("Reviewer")
  forumTopics                   ForumTopic[]                   @relation("ForumTopicAuthor")
  forumPosts                    ForumPost[]                    @relation("ForumPostAuthor")
  forumPollVotes                ForumPollVote[]                @relation("ForumPollVoter")
  forumReactions                ForumReaction[]                @relation("ForumReactionAuthor")
  forumSubscriptions            ForumSubscription[]            @relation("ForumSubscriber")
  forumReports                  ForumReport[]                  @relation("ForumReporter")
  telegramChats                 TelegramUserChat[]             @relation("TelegramChatMember")

  /// Репутация на форуме: сумма полученных реакций и отмеченных ответов.
  ///
  /// Хранится полем, а не считается запросом: число показывается рядом с
  /// каждым сообщением в теме, и подсчёт по всем реакциям человека на
  /// каждое из двадцати сообщений страницы — это двадцать запросов там,
  /// где нужно ноль.
  forumReputation Int @default(0)
  /// Сколько ответов этого человека отмечены как решившие вопрос.
  /// Показывается отдельно: «помог 28 раз» говорит больше, чем общая
  /// сумма очков, в которой смешаны благодарности и решения.
  forumBestAnswers Int @default(0)

  /// Сколько сообщений человек написал на форуме.
  ///
  /// Хранится полем, как и остальные счётчики форума: число стоит рядом
  /// с каждым сообщением в теме, и COUNT по всем сообщениям автора на
  /// каждое из двадцати сообщений страницы — это двадцать запросов там,
  /// где нужно ноль.
  forumPostCount Int @default(0)

  /// Когда человек последний раз заходил на форум.
  ///
  /// По ней подсвечиваются темы, где писали с тех пор: «что нового» —
  /// главный сценарий возврата постоянного читателя, и без отметки он
  /// каждый раз перечитывает список глазами, вспоминая, что уже видел.
  ///
  /// Одна отметка на человека, а не запись по каждой теме: полная
  /// прочитанность потребовала бы строки на каждый заход в каждую тему,
  /// то есть тысяч записей ради подсветки, которую видно и так.
  forumLastVisitAt DateTime?

  /// Подпись под сообщениями: чем человек ездит, чем занимается.
  ///
  /// На форуме о технике это не украшение: ответ «у меня так же было»
  /// значит разное от владельца той же машины и от постороннего. Обычный
  /// текст без разметки и ссылок — подпись видна под каждым сообщением, и
  /// ссылка в ней это реклама на всю площадку.
  forumSignature String?

  messagesSent                  Message[]                      @relation("MessageSender")
  messagesReceived              Message[]                      @relation("MessageReceiver")
  messageAttachments            MessageAttachment[]            @relation("MessageAttachmentUploader")
  aiServiceLogs                 AIServiceLog[]                 @relation("UserAIServiceLogs")
  sessions                      Session[]                      @relation("UserSessions")
  notifications                 Notification[]                 @relation("UserNotifications")
  comments                      Comment[]
  visitEvents                   VisitEvent[]                   @relation("UserVisitEvents")
  listingViewEvents             ListingViewEvent[]             @relation("UserListingViewEvents")
  deliveryOrdersAsBuyer         DeliveryOrder[]                @relation("DeliveryBuyer")
  deliveryOrdersAsPartner       DeliveryOrder[]                @relation("DeliveryPartner")
  deliveryOrdersManaged         DeliveryOrder[]                @relation("DeliveryManager")
  deliveryEvents                DeliveryEvent[]                @relation("DeliveryEventAuthor")
  deliveryDocuments             DeliveryDocument[]             @relation("DeliveryDocumentUploader")
  deliveryMessages              DeliveryMessage[]              @relation("DeliveryMessageSender")
  deliveryOrganizations         DeliveryOrganization[]         @relation("DeliveryOrganizationOwner")
  auctionInquiries              AuctionInquiry[]               @relation("AuctionInquiryRequester")
  assignedAuctionInquiries      AuctionInquiry[]               @relation("AuctionInquiryPartner")
  auctionInquiryAssignments     AuctionInquiry[]               @relation("AuctionInquiryAssigner")
  auctionInquiryOffers          AuctionInquiryOffer[]          @relation("AuctionInquiryOfferPartner")
  communicationModerationEvents CommunicationModerationEvent[] @relation("CommunicationModerationSender")
  reportsCreated                ListingReport[]                @relation("ListingReportReporter")
  fuelPriceReports              FuelPriceReport[]              @relation("FuelPriceReporter")
  adminAuditEvents              AdminAuditEvent[]              @relation("AdminAuditActor")
  partStores                    PartStore[]                    @relation("PartStoreOwner")
  partOrders                    PartOrder[]                    @relation("PartOrderBuyer")
  referralsMade                 ReferralAttribution[]          @relation("ReferralPartner")
  referralOrigin                ReferralAttribution?           @relation("ReferralInvitee")
  referralRewards               ReferralReward[]               @relation("ReferralRewardPartner")
  referralPayouts               ReferralPayout[]               @relation("ReferralPayoutPartner")
  reportsReviewed               ListingReport[]                @relation("ListingReportReviewer")
  promotionOrders               PromotionOrder[]
  supportTickets                SupportTicket[]                @relation("SupportTicketRequester")
  assignedSupportTickets        SupportTicket[]                @relation("SupportTicketAssignee")
  supportMessages               SupportMessage[]               @relation("SupportMessageAuthor")
  partRequests                  PartRequest[]                  @relation("PartRequestRequester")
  partRequestOffers             PartRequestOffer[]             @relation("PartRequestOfferSeller")

  @@index([email])
}

// Vehicle model - base model for all types of vehicles
model Vehicle {
  id                 String   @id @default(uuid())
  make               String // Manufacturer (Toyota, BMW, etc.)
  model              String // Model name (Camry, X5, etc.)
  year               Int
  price              Int // Price in rubles
  mileage            Int? // in kilometers; not applicable to water, air and special equipment
  operatingHours     Int? // Engine hours for special equipment and water transport
  flightHours        Int? // Airframe flight hours for aircraft
  vin                String?  @unique // Vehicle Identification Number for road vehicles
  serialNumber       String? // Factory serial number for special equipment
  registrationNumber String? // Airframe or vessel registration / hull identification number
  fuelType           String // GASOLINE, DIESEL, ELECTRIC, HYBRID, GAS, OTHER
  transmission       String // MANUAL, AUTOMATIC, VARIATOR, ROBOTIC
  bodyType           String? // SEDAN, HATCHBACK, SUV, COUPE, CONVERTIBLE, WAGON, MINIVAN, PICKUP, OTHER
  color              String?
  doors              Int?
  engineVolume       Float? // in liters
  power              Int? // in horsepower
  driveType          String? // FWD, RWD, AWD, FOUR_WD
  condition          String // NEW, LIKE_NEW, EXCELLENT, GOOD, FAIR, POOR
  steeringWheel      String? // LEFT, RIGHT (руль)
  ownersCount        Int? // количество владельцев
  documentsStatus    String? // CLEAN, ISSUES, MISSING
  damageInfo         String? // NONE, REPAINTED, DAMAGED, SEVERE
  sellerType         String? // OWNER, DEALER
  availability       String? // IN_STOCK, ON_ORDER, IN_TRANSIT
  customsCleared     Boolean? // растаможен
  generation         String? // поколение
  keywords           String? // ключевые слова для поиска
  vehicleType        String   @default("CAR")
  typeDetails        String? // JSON with transport-specific fields
  location           String // City, region
  lat                Float? // Latitude
  lng                Float? // Longitude
  description        String?
  // Images will be stored as JSON string or separate table - for simplicity using String
  images             String? // JSON array of image URLs as string

  // Foreign keys
  userId   String
  user     User     @relation(fields: [userId], references: [id], name: "UserVehicles")
  category Category @relation(fields: [categoryId], references: [id])

  // Reverse relation for listings
  listings   Listing[] @relation("ListingVehicle")
  categoryId String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for search optimization
  @@index([make, model])
  @@index([year])
  @@index([price])
  @@index([location])
  @@index([vin])
  @@index([serialNumber])
  @@index([registrationNumber])
}

// Vehicle categories

model PartCompatibility {
  id         String   @id @default(uuid())
  partId     String
  part       Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  make       String
  model      String
  generation String?
  yearFrom   Int?
  yearTo     Int?
  engine     String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([partId])
  @@index([make, model])
}

model PartCrossReference {
  id               String   @id @default(uuid())
  partId           String
  part             Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  number           String
  normalizedNumber String
  createdAt        DateTime @default(now())

  @@unique([partId, normalizedNumber])
  @@index([normalizedNumber])
}

model Category {
  id           String   @id @default(uuid())
  name         String // e.g., "Легковые автомобили"
  description  String?
  icon         String // Icon name from lucide-react
  vehicleCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  vehicles Vehicle[]

  @@unique([name])
}

// Auto parts model
model Part {
  id                  String               @id @default(uuid())
  name                String // Part name
  description         String?
  price               Int // Price in rubles
  condition           String // NEW, USED
  steeringWheel       String? // LEFT, RIGHT (руль)
  ownersCount         Int? // количество владельцев
  documentsStatus     String? // CLEAN, ISSUES, MISSING
  damageInfo          String? // NONE, REPAINTED, DAMAGED, SEVERE
  sellerType          String? // OWNER, DEALER
  availability        String? // IN_STOCK, ON_ORDER, IN_TRANSIT
  customsCleared      Boolean? // растаможен
  generation          String? // поколение
  keywords            String? // ключевые слова для поиска
  subcategory         String? // подкатегория (амортизаторы, колодки)
  oemNumber           String? // OEM номер
  suspensionType      String? // MACPHERSON, MULTI_LINK, TORSION
  brakeType           String? // DISC, DRUM, VENTED_DISC
  compatibility       PartCompatibility[]
  crossReferences     PartCrossReference[]
  vehicleType         String               @default("CAR")
  saleFormat          String               @default("FIXED") // FIXED or AUCTION
  auctionStatus       String               @default("ACTIVE")
  auctionEndsAt       DateTime?
  auctionStartPrice   Int?
  auctionCurrentPrice Int?
  auctionMinStep      Int?
  make                String // Compatible vehicle make
  model               String // Compatible vehicle model
  yearFrom            Int? // Compatible from year
  yearTo              Int? // Compatible to year
  partType            String // ENGINE, TRANSMISSION, SUSPENSION, BRAKES, ELECTRICAL, BODY, INTERIOR, WHEELS, ACCESSORIES, OTHER
  location            String // City, region
  lat                 Float? // Latitude
  lng                 Float? // Longitude
  // Images will be stored as JSON string or separate table - for simplicity using String
  images              String? // JSON array of image URLs as string

  // Foreign keys
  userId String
  user   User   @relation(fields: [userId], references: [id], name: "UserParts")

  // Позиция витрины магазина. Обычное частное объявление магазину не
  // принадлежит, поэтому связь необязательная.
  storeId String?
  store   PartStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  // Условия поставки под заказ: покупателю нужен срок и происхождение, а не
  // только цена, иначе заказ оформляется вслепую.
  supplyMode      String  @default("STOCK") // STOCK — на складе, ORDER — под заказ
  leadTimeDaysMin Int?
  leadTimeDaysMax Int?
  originCountry   String? // CN, KR, JP, DE, RU
  brandName       String? // производитель детали, а не автомобиля
  batchId         String? // партия массовой загрузки, чтобы её можно было откатить

  // Reverse relation for listings
  listings Listing[]   @relation("ListingPart")
  bids     PartBid[]
  orders   PartOrder[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([name])
  @@index([make, model])
  @@index([partType])
  @@index([partType, price, condition])
  @@index([storeId, createdAt])
  @@index([batchId])
  @@index([oemNumber])
}

// === МАГАЗИН ЗАПЧАСТЕЙ ===

// Витрина продавца: отдельная сущность, потому что у магазина есть реквизиты,
// условия доставки и репутация, которых нет у частного объявления.
model PartStore {
  id                     String   @id @default(uuid())
  ownerId                String
  owner                  User     @relation("PartStoreOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name                   String
  slug                   String   @unique
  description            String?
  logoUrl                String?
  legalName              String?
  inn                    String?
  contactPhone           String?
  contactEmail           String?
  city                   String?
  // Условия по умолчанию подставляются в новые позиции, чтобы продавцу не
  // приходилось заполнять их в каждой строке загрузки.
  defaultLeadTimeDaysMin Int?
  defaultLeadTimeDaysMax Int?
  defaultOriginCountry   String?
  status                 String   @default("DRAFT") // DRAFT, PENDING, ACTIVE, SUSPENDED
  statusReason           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  parts         Part[]
  batches       PartImportBatch[]
  orders        PartOrder[]
  requestOffers PartRequestOffer[]

  @@index([ownerId])
  @@index([status])
}

// Заказ позиции из витрины магазина.
//
// Цена и срок фиксируются на момент оформления: прайс магазина меняется, а
// покупатель и продавец должны обсуждать те условия, на которые согласились.
model PartOrder {
  id      String    @id @default(uuid())
  storeId String
  store   PartStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  partId  String?
  part    Part?     @relation(fields: [partId], references: [id], onDelete: SetNull)
  buyerId String?
  buyer   User?     @relation("PartOrderBuyer", fields: [buyerId], references: [id], onDelete: SetNull)

  // Контакты берутся из формы: заказ можно оформить и без регистрации.
  contactName  String
  contactPhone String
  contactEmail String?
  city         String?
  comment      String?

  quantity        Int     @default(1)
  // Снимок позиции: название и цена на момент заказа.
  itemName        String
  itemPriceRub    Int
  itemOemNumber   String?
  leadTimeDaysMin Int?
  leadTimeDaysMax Int?

  status       String   @default("NEW") // NEW, CONFIRMED, IN_DELIVERY, DONE, CANCELLED
  statusReason String?
  sellerNotes  String?
  ipHash       String? // антиспам без хранения адреса
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId, status, createdAt])
  @@index([buyerId, createdAt])
  @@index([partId])
}

// Партия массовой загрузки. Хранится отдельно, чтобы неудачный импорт можно
// было удалить целиком, а не искать позиции руками.
model PartImportBatch {
  id          String    @id @default(uuid())
  storeId     String
  store       PartStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fileName    String?
  status      String    @default("PREVIEW") // PREVIEW, APPLIED, REVERTED, FAILED
  totalRows   Int       @default(0)
  createdRows Int       @default(0)
  skippedRows Int       @default(0)
  errorReport String? // JSON: номер строки и причина отказа
  appliedAt   DateTime?
  revertedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([storeId, createdAt])
  @@index([status])
}

// Заявка «ищу деталь».
// В разделе запчастей пока нет позиций: продавцы не пришли, а покупатели
// заходят. Заявка переворачивает порядок — человек описывает деталь, а
// магазины отвечают предложениями. Витрине не нужно быть полной, чтобы
// раздел приносил пользу.
model PartRequest {
  id            String              @id @default(uuid())
  partName      String?
  oemNumber     String?
  make          String?
  model         String?
  year          Int?
  vin           String?
  condition     String              @default("ANY") // NEW, USED, ANY
  comment       String?
  // Насколько заявка понятна продавцу, 0-100. Считается при записи:
  // сортировать по нему в кабинете магазина дешевле, чем пересчитывать.
  clarity       Int                 @default(0)
  name          String
  phone         String
  email         String?
  city          String?
  contactMethod String              @default("PHONE") // PHONE, MESSENGER, EMAIL
  status        String              @default("NEW") // NEW, IN_PROGRESS, ANSWERED, CLOSED
  requesterId   String?
  requester     User?               @relation("PartRequestRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  managerNotes  String?
  closedAt      DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  offers        PartRequestOffer[]

  @@index([status, createdAt])
  @@index([requesterId, createdAt])
  @@index([oemNumber])
  @@index([make, model])
}

// Ответ магазина на заявку.
model PartRequestOffer {
  id            String      @id @default(uuid())
  requestId     String
  request       PartRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  storeId       String?
  store         PartStore?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  sellerId      String?
  seller        User?       @relation("PartRequestOfferSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  price         Int?
  condition     String? // NEW, USED
  leadTimeDays  Int?
  comment       String?
  status        String      @default("SENT") // SENT, ACCEPTED, DECLINED
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([requestId, createdAt])
  @@index([storeId, status])
  @@index([sellerId, createdAt])
}

model PartBid {
  id        String   @id @default(uuid())
  amount    Int
  partId    String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([partId, createdAt])
  @@index([userId, createdAt])
}

// Listing model (combines vehicles and parts for unified interface)
model Listing {
  id           String    @id @default(uuid())
  title        String
  description  String?
  price        Int // Price in rubles
  status       String    @default("ACTIVE") // DRAFT, PENDING_MODERATION, ACTIVE, PAUSED, REJECTED, SOLD, ARCHIVED
  statusReason String?
  isFeatured   Boolean   @default(false)
  promoType    String? // boost, premium, vip
  promoUntil   DateTime? // до какого числа действует продвижение
  views        Int       @default(0)

  // Polymorphic relation - can be either vehicle or part
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], name: "ListingVehicle")

  partId String?
  part   Part?   @relation(fields: [partId], references: [id], name: "ListingPart")

  // Foreign keys
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Reverse relation for favorites
  favoritedBy User[] @relation("Favorites")

  // Reverse relation for messages
  messages Message[] @relation("MessageListing")

  // Reverse relation for reviews
  reviews         Review[]             @relation("ListingReviews")
  statusEvents    ListingStatusEvent[]
  priceEvents     ListingPriceEvent[]
  revisions       ListingRevision[]
  /// Бесплатные публикации в чатах Telegram.
  chatPosts       ListingChatPost[]
  reports         ListingReport[]
  promotionOrders PromotionOrder[]
  viewEvents      ListingViewEvent[]

  // Timestamps
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  publishedAt         DateTime?
  archivedAt          DateTime?
  deletedAt           DateTime?
  lastStatusChangedAt DateTime?

  // Application validation and SQLite triggers enforce exactly one subject.

  @@index([createdAt])
  @@index([price])
  @@index([isFeatured])
  @@index([status, createdAt])
  @@index([userId, status, updatedAt])
  @@index([deletedAt])
}

// Individual listing opens for time-based seller/admin analytics. Raw IP
// addresses are never stored: ipHash uses the same server-side salted hash as
// the platform traffic counter. Unlike unique visitors, every accepted event
// remains a page view so repeated interest is visible in the funnel.
model ListingViewEvent {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  ipHash    String
  userId    String?
  user      User?    @relation("UserListingViewEvents", fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
  @@index([ipHash, createdAt])
  @@index([userId, createdAt])
  // Статистика выбирает просмотры за период по одному createdAt: составные
  // индексы такой запрос не покрывают.
  @@index([createdAt])
}

// Provider-neutral ledger for paid listing promotion. A row is created before
// redirecting to the payment provider and becomes PAID only from a verified
// webhook. Provider identifiers are unique to make webhook replay idempotent.
model PromotionOrder {
  id                 String    @id @default(uuid())
  listingId          String
  listing            Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tariffId           String
  amountRub          Int
  durationDays       Int
  status             String    @default("PENDING") // PENDING, PAID, FAILED, CANCELED, REFUNDED
  provider           String    @default("STRIPE")
  providerCheckoutId String?   @unique
  providerPaymentId  String?   @unique
  promoUntil         DateTime?
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  chatPosts          ChatPromotionPost[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([listingId, createdAt])
}

// Immutable record of every lifecycle decision. actorId intentionally remains
// nullable to retain historical actions if a user account is removed later.
/// История изменения цены объявления.
///
/// Покупатель принимает решение не только по самой цене, но и по её
/// движению: «снижена на 50 000 три дня назад» говорит о готовности
/// продавца торговаться, а рост цены — о том, что спешить не нужно.
///
/// Записи создаются только при фактическом изменении цены: правка описания
/// или фотографий историю не засоряет.
model ListingPriceEvent {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  oldPrice  Int
  newPrice  Int
  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
}

model ListingStatusEvent {
  id         String   @id @default(uuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  reason     String?
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([listingId, createdAt])
}

// Immutable snapshots of owner edits. The actor is stored as an id instead of
// a relation so retention of a user account never erases marketplace history.
model ListingRevision {
  id            String   @id @default(uuid())
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  actorId       String?
  changedFields String // JSON string array
  before        String // JSON snapshot of editable public fields
  after         String // JSON snapshot of editable public fields
  reason        String?
  createdAt     DateTime @default(now())

  @@index([listingId, createdAt])
}

// A user can report a listing once. Reports are intentionally separate from
// lifecycle events: moderation can investigate a complaint without changing
// the public status of an otherwise active listing.
model ListingReport {
  id         String    @id @default(uuid())
  listingId  String
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User      @relation("ListingReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  comment    String?
  status     String    @default("OPEN") // OPEN, IN_REVIEW, RESOLVED, DISMISSED
  reviewedAt DateTime?
  reviewerId String?
  reviewer   User?     @relation("ListingReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([listingId, reporterId])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

// Review model for transaction feedback
model Review {
  id      String  @id @default(uuid())
  rating  Int // 1-5 stars
  comment String?

  // Foreign keys
  userId String // Reviewer (user who left the review)
  user   User   @relation("Reviewer", fields: [userId], references: [id])

  // For transaction-based reviews, we might want to link to a specific transaction
  // For now, we'll keep it general but allow linking to a listing
  listingId String?
  listing   Listing? @relation("ListingReviews", fields: [listingId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Один отзыв автора на объявление: проверка «уже оставлен» шла кодом
  // без ограничения в базе, и два одновременных запроса создавали два
  // отзыва, вдвое искажая среднюю оценку. NULL здесь не конфликтует —
  // отзывы без привязки к объявлению не ограничены.
  @@unique([userId, listingId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
  // Отзывы карточки выбираются по объявлению — самый частый запрос модели.
  @@index([listingId, createdAt])
}

// Message model for user-to-user communication
model Message {
  id      String  @id @default(uuid())
  content String
  isRead  Boolean @default(false)

  // Conversation ID for efficient querying
  // Format: "{userId1}-{userId2}-{listingId}" or "{userId1}-{userId2}-no-listing"
  // where userId1 < userId2 alphabetically
  conversationId String

  // Foreign keys
  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id])

  receiverId String
  receiver   User   @relation("MessageReceiver", fields: [receiverId], references: [id])

  // Optional relation to listing (if message is about a specific listing)
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], name: "MessageListing")

  attachments MessageAttachment[]

  // Timestamps
  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([senderId, receiverId])
  @@index([createdAt])
  // Список диалогов ищет и по отправителю, и по получателю. Вторая ветка
  // не покрывалась: receiverId — второй столбец составного индекса.
  @@index([receiverId, createdAt])
}

// Фото из личной переписки хранятся вне public и выдаются только участникам
// диалога через авторизованный API. Отдельная модель не раскрывает storageKey
// в обычном ответе Message и позволяет удалить файлы вместе с сообщением.
model MessageAttachment {
  id           String   @id @default(uuid())
  messageId    String
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  storageKey   String   @unique
  uploadedById String
  uploadedBy   User     @relation("MessageAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([messageId, createdAt])
  @@index([uploadedById, createdAt])
}

// Favorite listings (many-to-many relationship between users and listings)
// Handled implicitly through the relations in User and Listing models

// AI Service logs (to track usage of AI features)
model AIServiceLog {
  id               String  @id @default(uuid())
  serviceType      String // VALUATION, HISTORY_CHECK, SIMILAR_SEARCH, PRICE_PREDICTION, DAMAGE_ASSESSMENT, SMART_MATCHING
  status           String  @default("COMPLETED") // REQUESTED, PROCESSING, COMPLETED, FAILED
  provider         String? // Provider or calculation engine that produced the result
  subjectVehicleId String?
  inputData        String? // Input data for the AI service (stored as JSON string)
  resultData       String? // Result from the AI service (stored as JSON string)

  // Foreign keys
  userId String?
  user   User?   @relation(fields: [userId], references: [id], name: "UserAIServiceLogs")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceType, createdAt])
  @@index([userId, serviceType, status, createdAt])
}

// Dedicated support workflow. Guest visitors receive an opaque browser token;
// only its SHA-256 hash is stored so a database leak cannot expose live access.
model SupportTicket {
  id                  String           @id @default(uuid())
  publicTokenHash     String           @unique
  userId              String?
  user                User?            @relation("SupportTicketRequester", fields: [userId], references: [id], onDelete: SetNull)
  guestName           String?
  guestEmail          String?
  guestPhone          String?
  subject             String           @default("Общий вопрос")
  status              String           @default("OPEN") // OPEN, WAITING_OPERATOR, IN_PROGRESS, CLOSED
  mode                String           @default("AI") // AI, OPERATOR
  priority            String           @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  assignedToId        String?
  assignedTo          User?            @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastMessageAt       DateTime         @default(now())
  lastReadByStaffAt   DateTime?
  lastReadByVisitorAt DateTime?
  closedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  messages            SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([mode, status, lastMessageAt])
  @@index([userId, status, lastMessageAt])
  @@index([assignedToId, status, lastMessageAt])
}

model SupportMessage {
  id           String        @id @default(uuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType   String // GUEST, USER, AI, OPERATOR, SYSTEM
  authorUserId String?
  authorUser   User?         @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  content      String
  metadata     String?
  createdAt    DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@index([authorUserId, createdAt])
}

model SupportKnowledgeArticle {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  summary     String
  content     String
  keywords    String
  link        String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

// Session model for NextAuth
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], name: "UserSessions")
  expires      DateTime

  @@index([sessionToken])
  @@index([userId])
}

// Notification model for in-app notifications
model Notification {
  id          String  @id @default(uuid())
  title       String
  content     String
  isRead      Boolean @default(false)
  type        String // INFO, WARNING, ERROR, SUCCESS
  relatedId   String? // ID of related entity (listing, message, etc.)
  relatedType String? // Type of related entity (LISTING, MESSAGE, USER, etc.)

  // Foreign keys
  userId String
  user   User   @relation(fields: [userId], references: [id], name: "UserNotifications")

  // Timestamps
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  // Список уведомлений: фильтр по пользователю с сортировкой по дате.
  // Ни один из существующих индексов не покрывал оба условия сразу.
  @@index([userId, createdAt])
}

// VerificationToken model for NextAuth
model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([token])
}

// Privacy-safe product analytics: raw IP is never stored.
model VisitEvent {
  id            String   @id @default(uuid())
  path          String
  visitorKey    String?
  sessionKey    String?
  ipHash        String?
  userAgent     String?
  referer       String?
  deviceType    String?
  trafficSource String?
  campaign      String?
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], name: "UserVisitEvents")
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([visitorKey, createdAt])
  @@index([sessionKey, createdAt])
  @@index([deviceType, createdAt])
  @@index([trafficSource, createdAt])
  @@index([userId, createdAt])
  // Посетитель без кук опознаётся по ipHash: без индекса каждый его
  // просмотр страницы сканировал таблицу целиком.
  @@index([ipHash, createdAt])
}

// One-time codes delivered by the Telegram bot for phone login.
model TelegramAuthCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  purpose    String    @default("LOGIN")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

// Persistent outbox for temporary system notices in Telegram groups. A
// database queue survives application and polling-worker restarts, unlike a
// process-local setTimeout.
model TelegramMessageCleanup {
  id          String    @id @default(cuid())
  chatId      String
  messageId   Int
  deleteAt    DateTime
  attempts    Int       @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([chatId, messageId])
  @@index([processedAt, deleteAt])
}

// Groups and supergroups where the bot has been seen. The registry keeps the
// 12-hour service campaign idempotent across worker restarts and lets chat
// administrators opt out without removing the bot.
/// Личный диалог с ботом.
///
/// Запись появляется при первом «Начать», даже если человек так и не
/// подтвердил телефон: до этого такие люди терялись бесследно, а именно они
/// и составляют основную аудиторию рассылки.
///
/// Хранится минимум: Telegram ID, имя для обращения и отметки активности.
/// Телефон и почта живут в User и появляются только после регистрации.
/// Журнал массовых рассылок.
///
/// Рассылку нельзя отозвать, поэтому важно видеть, что и когда ушло: без
/// записи невозможно ни проверить факт отправки, ни разобрать жалобу, ни
/// понять, почему часть людей заблокировала бота после конкретного письма.
/// Сохранённый поиск с уведомлениями о новых лотах.
///
/// Человек редко покупает машину в первый визит: он присматривается неделями.
/// Без подписки ему приходится возвращаться и проверять каталог вручную — и
/// чаще всего он просто не возвращается.
///
/// Уведомления идут в Telegram: бот уже связан с аккаунтом, доставка мгновенная
/// и бесплатная, в отличие от почты.
model SavedSearch {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Человеческое название — чтобы список подписок читался.
  title String

  /// Раздел: объявления площадки или импортные аукционы.
  scope String @default("LISTINGS")

  /// Условия поиска строкой запроса, тем же форматом, что и в адресе страницы:
  /// подписка должна открываться одним переходом.
  query String

  notifyTelegram Boolean @default(true)

  /// От этой отметки отсчитываются «новые» лоты.
  lastNotifiedAt DateTime?
  lastMatchCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([notifyTelegram, lastNotifiedAt])
}

model TelegramBroadcast {
  id        String @id @default(uuid())
  text      String
  audience  String
  total     Int
  delivered Int
  blocked   Int
  failed    Int

  /// Кто отправил — рассылка доступна нескольким администраторам.
  sentById   String?
  sentByName String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model TelegramContact {
  telegramId String  @id
  username   String?
  firstName  String?
  lastName   String?

  /// Прошёл ли человек регистрацию — обновляется при её завершении.
  registered Boolean @default(false)

  /// Заблокировал ли бота. Telegram отвечает «bot was blocked by the user»;
  /// таким рассылка больше не отправляется, иначе очередь копит отказы.
  blocked Boolean @default(false)

  startedAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  lastBroadcastAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([blocked, registered])
  @@index([lastBroadcastAt])
}

/// Бесплатная публикация объявления в чате продавца.
///
/// Отдельно от ChatPromotionPost: тот привязан к оплаченному заказу и
/// живёт по его сроку, а эта запись нужна лишь для того, чтобы не
/// отправить одно объявление в тот же чат дважды.
model ListingChatPost {
  id        String @id @default(uuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  chatId    String

  /// Идентификатор сообщения: по нему пост убирается, когда объявление
  /// снимают с площадки.
  messageId Int

  publishedAt DateTime  @default(now())
  removedAt   DateTime?

  /// Одно объявление — один пост в чате. Ограничение в базе: объявление
  /// могли снять и вернуть, а два одинаковых поста подряд раздражают
  /// больше, чем их отсутствие.
  @@unique([listingId, chatId])
  @@index([chatId, publishedAt])
}

/// Из какого чата человек пришёл на площадку.
///
/// Объявление уходит именно туда: его увидят те, среди кого продавец уже
/// состоит, а не посторонние из общего потока. Для форума под Владивосток
/// это разница между «продаю Prado» среди своих и тем же объявлением
/// среди всей страны.
///
/// Связь записывается, когда человек пишет в группе с ботом: там видно и
/// его, и чат сразу. При регистрации на сайте таких сведений нет вовсе.
model TelegramUserChat {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("TelegramChatMember", fields: [userId], references: [id], onDelete: Cascade)
  chatId String
  chat   TelegramChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  /// Когда человека последний раз видели в этом чате. По ней выбирается
  /// чат для публикации, если он состоит в нескольких: свежий ближе.
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, chatId])
  @@index([userId, lastSeenAt])
}

model TelegramChat {
  id               String    @id
  type             String
  title            String?
  marketingEnabled Boolean   @default(true)
  active           Boolean   @default(true)
  lastSeenAt       DateTime  @default(now())
  lastPromoAt      DateTime?
  lastPromoMessage Int?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  members TelegramUserChat[]

  @@index([active, marketingEnabled, lastPromoAt])
  @@index([lastSeenAt])
}

model News {
  id              String    @id @default(uuid())
  title           String
  slug            String?   @unique
  content         String
  excerpt         String?
  imageUrl        String?
  sourceUrl       String?
  telegramUrl     String?
  sourceKey       String?   @unique
  sourceChannel   String?
  sourceMessageId Int?
  author          String?
  tags            String?
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime
  views           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  comments        Comment[]

  @@index([publishedAt])
  @@index([sourceChannel, sourceMessageId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  newsId    String?
  news      News?    @relation(fields: [newsId], references: [id])
  createdAt DateTime @default(now())
}

// === АУКЦИОННЫЙ АГРЕГАТОР ===

model AuctionListing {
  id                  String    @id @default(uuid())
  sourceId            String // ID лота на источнике (дедупликация)
  source              String // EMARAAT, AJ, COPART, IAAI, USS, TAA, MOBILE_DE
  sourceUrl           String // ссылка на оригинал
  // Данные ТС
  make                String
  model               String
  year                Int
  manufacturedMonth   String? // YYYY-MM from the source when it is available
  mileage             Int?
  fuelType            String?
  transmission        String?
  bodyType            String?
  color               String?
  engineVolume        Float? // cubic centimetres for imported auction vehicles
  power               Int?
  driveType           String?
  vin                 String?
  lotNumber           String?
  // Цена
  sourcePrice         Int // цена на аукционе
  sourceCurrency      String // JPY, KRW, USD, EUR
  priceRub            Int // цена в рублях
  markup              Int // наценка
  finalPrice          Int // итоговая цена для покупателя
  exchangeRate        Float? // снимок курса ЦБ, использованный при расчёте
  pricingUpdatedAt    DateTime? // когда цена была пересчитана по актуальному курсу
  // Медиа (прямые ссылки)
  imageUrl            String?
  images              String? // JSON массив
  // Перевод
  descriptionOrig     String?
  specsOrig           String?
  descriptionRu       String?
  specsRu             String?
  equipment           String? // JSON: source-confirmed options and their availability
  conditionInfo       String? // JSON: source-confirmed inspection, insurance and new-car comparison
  // Локация
  country             String // JP, KR, US, DE
  auctionDate         DateTime?
  location            String?
  // Статус
  status              String    @default("ACTIVE") // ACTIVE, SOLD, EXPIRED, POLICY_EXCLUDED
  adminHiddenAt       DateTime? // manual moderation override; collectors must not reset it
  adminHiddenReason   String?
  isTranslated        Boolean   @default(false)
  translatedAt        DateTime?
  lastChecked         DateTime  @default(now()) // последняя попытка проверки источника
  sourceLastSeenAt    DateTime? // подтверждённое присутствие на исходной площадке
  sourceMissingChecks Int       @default(0) // подряд подтверждённых отсутствий у источника
  viewCount           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  inquiries      AuctionInquiry[]
  deliveryOrders DeliveryOrder[]
  telegramPosts  AuctionTelegramPost[]

  @@unique([source, sourceId])
  @@index([source])
  @@index([status])
  @@index([adminHiddenAt])
  @@index([make, model])
  @@index([country])
  @@index([auctionDate])
  @@index([country, source, status, auctionDate])
  @@index([source, status, lastChecked])
  @@index([source, status, sourceLastSeenAt])
  // Каталог: выборка публичных лотов с сортировкой по дате.
  // Индекс только на status не покрывал сортировку — база строила
  // временное дерево по всем строкам на каждый запрос страницы. Замер на
  // копии базы с 33 751 лотом: первая страница 206 → 3 мс, сто
  // восемьдесят седьмая 874 → 19 мс.
  @@index([status, adminHiddenAt, createdAt])
  // Медиана цены и фильтр по году в том же каталоге: без этого индекса
  // база сортировала всю выборку и отбрасывала половину. На копии
  // 203 → 23 мс.
  @@index([status, adminHiddenAt, finalPrice])
}

// История запусков импорта. Она отделена от карточек, чтобы администратор мог
// отличить сбой источника от снятого объявления и не терять диагностические
// данные при скрытии просроченных лотов из публичного каталога.
model AuctionSyncRun {
  id               String    @id @default(uuid())
  source           String
  syncKind         String // DISCOVERY, REFRESH
  status           String    @default("RUNNING") // RUNNING, SUCCEEDED, PARTIAL, FAILED
  catalogUrl       String?
  requestedLimit   Int
  discovered       Int       @default(0)
  imported         Int       @default(0)
  created          Int       @default(0)
  updated          Int       @default(0)
  failed           Int       @default(0)
  skippedByPolicy  Int       @default(0)
  excludedByPolicy Int       @default(0)
  expired          Int       @default(0)
  error            String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([source, startedAt])
  @@index([status, startedAt])
}

model ExchangeRate {
  currency    String    @id // ISO: USD, EUR, JPY, KRW, CNY
  rateToRub   Float // стоимость одной единицы валюты в рублях
  source      String // CBR или резервный источник
  effectiveAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
}

model AuctionInquiry {
  id                 String                @id @default(uuid())
  auctionListingId   String
  auctionListing     AuctionListing        @relation(fields: [auctionListingId], references: [id], onDelete: Cascade)
  name               String
  phone              String
  email              String?
  city               String?
  comment            String?
  status             String                @default("NEW") // NEW, CONTACTED, IN_PROGRESS, CLOSED, SOLD
  managerNotes       String?
  requesterId        String?
  requester          User?                 @relation("AuctionInquiryRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  assignedPartnerId  String?
  assignedPartner    User?                 @relation("AuctionInquiryPartner", fields: [assignedPartnerId], references: [id], onDelete: SetNull)
  assignedById       String?
  assignedBy         User?                 @relation("AuctionInquiryAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt         DateTime?
  deliveryOrderId    String?               @unique
  deliveryOrder      DeliveryOrder?        @relation(fields: [deliveryOrderId], references: [id], onDelete: SetNull)
  monetizationModel  String                @default("DEAL_FEE") // DEAL_FEE, APPLICATION_FEE, SUBSCRIPTION
  platformFeeAmount  Int?
  buyerDepositAmount Int?
  startedAt          DateTime?
  closedAt           DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  offers             AuctionInquiryOffer[]

  @@index([auctionListingId])
  @@index([status])
  @@index([requesterId, createdAt])
  @@index([assignedPartnerId, status])
}

// === МЕЖДУНАРОДНАЯ ДОСТАВКА ===
// Денежные переводы на площадке не исполняются: в модели хранятся только
// реквизиты выставленного счёта, статус проверки квитанции и журнал сделки.

model DeliveryOrganization {
  id                 String                @id @default(uuid())
  ownerId            String
  owner              User                  @relation("DeliveryOrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  legalName          String
  inn                String                @unique
  ogrn               String?
  organizationType   String                @default("COMPANY") // COMPANY, ENTREPRENEUR, BROKER, LOGISTICS
  serviceRegions     String? // JSON array of regions/cities
  verificationStatus String                @default("PENDING") // PENDING, VERIFIED, REJECTED, SUSPENDED
  verificationSource String? // MANUAL, FNS, PARTNER
  fnsCheckedAt       DateTime?
  verificationNote   String?
  // Показатели качества работы. Считаются из фактических заявок и офферов, а
  // здесь хранятся денормализованно: распределение выполняется на каждой новой
  // заявке и не должно каждый раз пересчитывать историю всех партнёров.
  slaResponseMinutes Int? // медиана времени ответа на предложение
  slaAcceptedOffers  Int                   @default(0)
  slaMissedOffers    Int                   @default(0) // истёкшие без ответа
  slaClosedDeals     Int                   @default(0)
  slaRating          Int                   @default(0) // 0..100, пересчитывается фоново
  slaUpdatedAt       DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  inquiryOffers      AuctionInquiryOffer[]

  @@index([ownerId])
  @@index([verificationStatus])
  @@index([verificationStatus, slaRating])
}

model AuctionInquiryOffer {
  id             String               @id @default(uuid())
  inquiryId      String
  inquiry        AuctionInquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  partnerId      String
  partner        User                 @relation("AuctionInquiryOfferPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  organizationId String
  organization   DeliveryOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         String               @default("OFFERED") // OFFERED, ACCEPTED, DECLINED, EXPIRED, SUPERSEDED (заявку принял другой партнёр)
  matchScore     Int                  @default(0)
  matchReason    String?
  expiresAt      DateTime
  respondedAt    DateTime?
  createdAt      DateTime             @default(now())

  @@unique([inquiryId, partnerId])
  @@index([partnerId, status, expiresAt])
  @@index([inquiryId, status])
  @@index([organizationId, status])
}

model DeliveryOrder {
  id                  String          @id @default(uuid())
  code                String          @unique
  kind                String          @default("VEHICLE") // VEHICLE, PART
  sourceType          String          @default("AUCTION") // AUCTION, DIRECT_IMPORT, PARTS_ORDER
  status              String          @default("REQUEST_CREATED")
  statusSource        String          @default("MANUAL") // MANUAL, PARTNER, BROKER, OFFICIAL_API
  title               String
  description         String?
  auctionListingId    String?
  auctionListing      AuctionListing? @relation(fields: [auctionListingId], references: [id], onDelete: SetNull)
  vin                 String?
  lotNumber           String?
  originCountry       String
  originCity          String?
  originCheckpoint    String?
  transitCity         String?
  destinationCity     String
  destinationRegion   String?
  buyerId             String
  buyer               User            @relation("DeliveryBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  partnerId           String?
  partner             User?           @relation("DeliveryPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  managerId           String?
  manager             User?           @relation("DeliveryManager", fields: [managerId], references: [id], onDelete: SetNull)
  buyerDepositAmount  Int?
  buyerDepositStatus  String          @default("NOT_REQUESTED")
  monetizationModel   String          @default("DEAL_FEE") // DEAL_FEE, APPLICATION_FEE, SUBSCRIPTION
  platformFeeAmount   Int?
  platformFeeStatus   String          @default("NOT_REQUESTED")
  depositPaidAt       DateTime?
  expectedPurchaseAt  DateTime?
  purchasedAt         DateTime?
  estimatedDeliveryAt DateTime?
  completedAt         DateTime?
  nextAction          String?
  nextActionAt        DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  events           DeliveryEvent[]
  payments         DeliveryPayment[]
  documents        DeliveryDocument[]
  messages         DeliveryMessage[]
  auctionInquiry   AuctionInquiry?
  moderationEvents CommunicationModerationEvent[]

  @@index([buyerId, updatedAt])
  @@index([partnerId, updatedAt])
  @@index([managerId, updatedAt])
  @@index([status, updatedAt])
  @@index([auctionListingId])
}

model DeliveryEvent {
  id               String        @id @default(uuid())
  deliveryOrderId  String
  deliveryOrder    DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  status           String
  title            String
  description      String?
  responsibleRole  String        @default("PLATFORM") // BUYER, PARTNER, BROKER, LOGISTICS, PLATFORM
  source           String        @default("MANUAL")
  isVisibleToBuyer Boolean       @default(true)
  expectedAt       DateTime?
  completedAt      DateTime      @default(now())
  authorId         String?
  author           User?         @relation("DeliveryEventAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  metadata         String? // JSON: reference/checkpoint/external status identifier
  createdAt        DateTime      @default(now())

  @@index([deliveryOrderId, completedAt])
  @@index([status])
}

model DeliveryPayment {
  id                String        @id @default(uuid())
  deliveryOrderId   String
  deliveryOrder     DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  category          String // DEPOSIT, VEHICLE, EXPORT, BROKER, DUTY, LABORATORY, EPTS, LOGISTICS
  status            String        @default("DRAFT") // DRAFT, INVOICE_ISSUED, AWAITING_CONFIRMATION, CONFIRMED, OVERDUE, CANCELED
  amount            Int?
  currency          String        @default("RUB")
  payeeName         String?
  invoiceNumber     String?
  instruction       String?
  dueAt             DateTime?
  paidAt            DateTime?
  confirmedAt       DateTime?
  receiptDocumentId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([deliveryOrderId, status])
  @@index([category])
}

model AuctionTelegramPost {
  id               String         @id @default(uuid())
  auctionListingId String
  auctionListing   AuctionListing @relation(fields: [auctionListingId], references: [id], onDelete: Cascade)
  chatId           String
  messageId        String?
  createdAt        DateTime       @default(now())

  @@unique([auctionListingId, chatId])
  @@index([chatId, createdAt])
  @@index([createdAt])
}

model DeliveryDocument {
  id              String        @id @default(uuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  title           String
  category        String // INVOICE, RECEIPT, EXPORT, CUSTOMS, LABORATORY, EPTS, CONTRACT, OTHER
  visibility      String        @default("BUYER_AND_TEAM") // BUYER_AND_TEAM, TEAM_ONLY
  fileName        String
  mimeType        String
  size            Int
  storageKey      String        @unique
  uploadedById    String
  uploadedBy      User          @relation("DeliveryDocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@index([deliveryOrderId, createdAt])
  @@index([visibility])
}

model DeliveryMessage {
  id              String        @id @default(uuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User          @relation("DeliveryMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content         String
  isSystem        Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@index([deliveryOrderId, createdAt])
}

// Audit trail for content rejected before it reaches the other participant.
// The original message is deliberately not stored; only a redacted preview
// and machine-readable reasons remain available to administrators.
model CommunicationModerationEvent {
  id              String        @id @default(uuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User          @relation("CommunicationModerationSender", fields: [senderId], references: [id], onDelete: Cascade)
  decision        String        @default("BLOCKED") // BLOCKED, REVIEW
  reasonCodes     String // JSON array
  redactedPreview String?
  provider        String        @default("LOCAL_POLICY") // LOCAL_POLICY, NVIDIA, LOCAL_POLICY+NVIDIA
  createdAt       DateTime      @default(now())

  @@index([deliveryOrderId, createdAt])
  @@index([senderId, createdAt])
  @@index([decision, createdAt])
}

// === АУКЦИОННЫЙ АГРЕГАТОР ===

// === ЦЕНЫ НА ТОПЛИВО ОТ ПОЛЬЗОВАТЕЛЕЙ ===

// Открытые картографические данные содержат виды топлива, но не цены, а
// публичные API сетей АЗС требуют платного договора. Поэтому цена приходит от
// водителей: каждая отметка хранится отдельно и остаётся проверяемой, а карта
// показывает согласованное значение вместо одиночного мнения.
model FuelPriceReport {
  id         String    @id @default(uuid())
  stationId  String // идентификатор точки на карте, например osm-node-123
  latitude   Float
  longitude  Float
  fuel       String // AI92, AI95, AI98, AI100, DT, GAS
  priceRub   Int // цена в копейках, чтобы не хранить дробное значение
  userId     String?
  user       User?     @relation("FuelPriceReporter", fields: [userId], references: [id], onDelete: SetNull)
  ipHash     String? // антиспам без хранения адреса
  status     String    @default("ACTIVE") // ACTIVE, REJECTED, SUPERSEDED
  rejectedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([stationId, fuel, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// === ЖУРНАЛ ДЕЙСТВИЙ АДМИНИСТРАТОРА ===

// Решения администратора меняют видимость чужого контента и роли, поэтому они
// должны оставаться восстановимыми. Журнал только дополняется: запись не
// правится и не удаляется вместе с целевой сущностью.
model AdminAuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String? // сохраняется отдельно, чтобы запись пережила удаление аккаунта
  action     String // AUCTION_LOT_HIDE, USER_ROLE_CHANGE, LISTING_MODERATE, ...
  entityType String // AuctionListing, User, Listing, SupportTicket, ...
  entityId   String?
  summary    String // человекочитаемое описание решения
  metadata   String? // JSON с деталями до/после
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

// === ПАРТНЁРСКАЯ ПРОГРАММА ===

// Кто кого привёл. Связь фиксируется один раз при регистрации и не меняется:
// иначе вознаграждение можно было бы переписать задним числом.
model ReferralAttribution {
  id        String   @id @default(uuid())
  partnerId String
  partner   User     @relation("ReferralPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  inviteeId String   @unique
  invitee   User     @relation("ReferralInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  code      String
  source    String? // страница или канал перехода
  createdAt DateTime @default(now())

  @@index([partnerId, createdAt])
  @@index([code])
}

// Начисление за оплату приглашённого. Хранится как отдельная запись, чтобы
// история начислений оставалась проверяемой, даже если тариф позже отменят.
model ReferralReward {
  id               String   @id @default(uuid())
  partnerId        String
  partner          User     @relation("ReferralRewardPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  inviteeId        String
  promotionOrderId String   @unique
  // Сумма платежа и процент на момент начисления: шкала со временем меняется,
  // а уже начисленное пересчитывать нельзя.
  orderAmountRub   Int
  percent          Int
  amountRub        Int
  status           String   @default("ACCRUED") // ACCRUED, PAID, CANCELLED
  cancelReason     String?
  createdAt        DateTime @default(now())

  @@index([partnerId, status, createdAt])
}

// Выплата, которую администратор провёл вручную по расчётному счёту.
// Площадка не переводит деньги сама, поэтому запись фиксирует факт перевода,
// а не инициирует его.
model ReferralPayout {
  id          String   @id @default(uuid())
  partnerId   String
  partner     User     @relation("ReferralPayoutPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  amountRub   Int
  method      String? // расчётный счёт, карта, иное
  reference   String? // номер платёжного поручения
  comment     String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([partnerId, createdAt])
}

/// Сохранённые переводы источников.
///
/// Кэш в памяти процесса терялся при каждом перезапуске, и после деплоя
/// сборщик переводил те же названия заново — через прокси это десятки секунд
/// на строку. Переводы детерминированы, поэтому хранятся между запусками.
model TranslationCache {
  /// Хэш исходного текста вместе с режимом перевода.
  key        String   @id
  sourceText String
  translated String
  /// Режим: обычный перевод или нормализация названия модели.
  mode       String   @default("text")
  hits       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([updatedAt])
}

/// Раздел форума.
///
/// Форум решает задачу, которой не решает каталог: приводит людей, ещё не
/// готовых покупать. Человек ищет «как растаможить машину из Кореи» и
/// попадает на площадку задолго до того, как соберётся за машиной.
///
/// Разделы устроены по трём осям сразу — география, происхождение марки и
/// тема. Так делает drom.ru, и так человек ищет: одному нужен «Урал», другому
/// «китайские», третьему «запчасти».
model ForumSection {
  id    String @id @default(uuid())
  /// Человекочитаемый адрес: /forum/ural, /forum/china.
  slug  String @unique
  title String
  /// Короткое пояснение под названием в списке разделов.
  description String?
  /// Ось: REGION, ORIGIN или TOPIC. Определяет группу в списке разделов.
  groupKey    String
  /// Порядок внутри группы: разделы перечисляются осмысленно, а не по алфавиту.
  position    Int    @default(0)

  /// Родительский раздел.
  ///
  /// Плоский список из двадцати трёх разделов не вмещает того, как люди
  /// на самом деле ищут: владельцу Camry нужен не «японские автомобили», а
  /// раздел про его машину. Вложенность даёт и точный адрес обсуждения, и
  /// отдельную страницу под поисковый запрос «форум Toyota Camry».
  parentId String?
  parent   ForumSection?  @relation("SectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ForumSection[] @relation("SectionTree")

  /// Счётчики хранятся полями, а не считаются запросом: список разделов
  /// открывается на каждый заход, а COUNT по всем темам и сообщениям на
  /// SQLite при росте форума становится самым дорогим запросом страницы.
  topicCount Int @default(0)
  postCount  Int @default(0)

  lastPostAt DateTime?

  createdAt DateTime @default(now())
  topics    ForumTopic[]

  @@index([groupKey, position])
  @@index([parentId, position])
}

/// Тема форума.
model ForumTopic {
  id        String @id @default(uuid())
  slug      String @unique
  title     String
  sectionId String
  section   ForumSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  authorId  String
  author    User @relation("ForumTopicAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// Закреплённые темы идут первыми: правила раздела и важные объявления.
  isPinned Boolean @default(false)
  /// Закрытая тема доступна для чтения, но не для ответов.
  isClosed Boolean @default(false)

  /// Метка темы: HELP, SOLVED, REPORT, SELL, BUY, QUESTION.
  ///
  /// Метка организует раздел лучше, чем деление на подразделы: в одном
  /// списке видно, где просят помощи, где уже нашли решение, а где
  /// продают. По ней же фильтруют — человек с поломкой ищет «Помогите», а
  /// не читает подряд.
  prefix String?

  views      Int @default(0)
  replyCount Int @default(0)

  /// Дата последнего сообщения: по ней сортируется список тем. Хранится
  /// полем, иначе каждая сортировка тянула бы подзапрос по всем сообщениям.
  lastPostAt DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Мягкое удаление: тема с обсуждением не исчезает бесследно.
  deletedAt DateTime?

  posts ForumPost[]
  subscriptions ForumSubscription[]
  /// Опрос необязателен и всегда один: два голосования в одном
  /// обсуждении делят внимание, и оба остаются недоголосованными.
  poll  ForumPoll?

  @@index([sectionId, isPinned, lastPostAt])
  @@index([authorId])
  @@index([deletedAt])
}

/// Сообщение в теме.
model ForumPost {
  id       String @id @default(uuid())
  topicId  String
  topic    ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId String
  author   User @relation("ForumPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content  String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Мягкое удаление: на месте удалённого модератором сообщения остаётся
  /// пометка, иначе ответы на него теряют смысл.
  deletedAt DateTime?

  /// Когда автор правил сообщение сам.
  ///
  /// Отдельно от updatedAt: тот меняется от любого изменения строки, в том
  /// числе от чужой отметки «решило вопрос» и от счётчика реакций. Метка
  /// «изменено» под сообщением должна означать правку текста автором, а не
  /// то, что кто-то нажал значок.
  editedAt DateTime?

  /// Отмечен автором темы как ответ, который решил вопрос.
  ///
  /// Отметка одна на тему и её ставит автор вопроса: он единственный
  /// знает, что именно помогло. Человеку, пришедшему из поиска с тем же
  /// вопросом, отмеченный ответ экономит чтение сорока сообщений.
  isBestAnswer Boolean @default(false)

  /// Сколько всего реакций собрало сообщение. Хранится полем, а не
  /// считается запросом: страница темы открывается на каждый заход, и
  /// COUNT по реакциям всех сообщений стал бы самым дорогим запросом.
  reactionCount Int @default(0)

  reactions ForumReaction[]
  reports   ForumReport[]

  @@index([topicId, createdAt])
  @@index([authorId])
  /// Поиск лучшего ответа в теме: он показывается над остальными.
  @@index([topicId, isBestAnswer])
}

/// Подписка на тему форума.
///
/// Человек спросил и ушёл: без уведомления он не узнает, что ответили, и
/// вернётся разве что случайно. Автор темы подписывается сам при её
/// создании, остальные — кнопкой.
model ForumSubscription {
  id      String     @id @default(uuid())
  topicId String
  topic   ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId  String
  user    User       @relation("ForumSubscriber", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Одна подписка на человека и тему. Ограничение в базе: два нажатия
  /// подряд уходят двумя запросами одновременно.
  @@unique([topicId, userId])
  @@index([userId])
}

/// Жалоба на сообщение форума.
///
/// Без неё спам убирать некому: модератор не читает каждую тему, а
/// участник, наткнувшийся на рекламу, уходит и больше не возвращается.
model ForumReport {
  id       String    @id @default(uuid())
  postId   String
  post     ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User      @relation("ForumReporter", fields: [authorId], references: [id], onDelete: Cascade)

  /// Причина: SPAM, RUDE, OFFTOPIC, WRONG, OTHER.
  reason  String
  /// Пояснение своими словами — необязательное.
  comment String?

  /// Разобрана ли жалоба. Хранится здесь, а не отдельной таблицей: у
  /// жалобы два состояния, и заводить под это очередь со статусами
  /// преждевременно.
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  /// Одна жалоба от человека на сообщение: десять жалоб от одного не
  /// делают проблему серьёзнее, а очередь модератора засоряют.
  @@unique([postId, authorId])
  @@index([resolvedAt, createdAt])
}

/// Реакция на сообщение форума.
///
/// «Спасибо, помогло» пишут отдельным сообщением, и в теме о ремонте
/// половина ответов — благодарности, между которыми теряется суть.
/// Реакция говорит то же самое, не занимая места в разговоре.
model ForumReaction {
  id     String    @id @default(uuid())
  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation("ForumReactionAuthor", fields: [userId], references: [id], onDelete: Cascade)

  /// Вид реакции: HELPFUL, THANKS, ACCURATE. Список закрытый и короткий —
  /// два десятка значков превращают ответы в ярмарку, а не в оценку.
  kind String

  createdAt DateTime @default(now())

  /// Одна реакция каждого вида от человека на сообщение. Ограничение
  /// стоит в базе: два нажатия подряд уходят двумя запросами
  /// одновременно, и проверка в коде пропустила бы оба.
  @@unique([postId, userId, kind])
  @@index([postId])
}

/// Опрос в теме форума.
///
/// Вопрос «какую взять» повторяется в каждом втором обсуждении, и ответы
/// тонут в сотне сообщений. Опрос собирает то же мнение в цифру, которую
/// видно сразу, и удерживает человека в теме: проголосовавший приходит
/// смотреть, чем кончилось.
///
/// Опрос один на тему: два опроса в одном обсуждении делят внимание и
/// оба остаются недоголосованными.
model ForumPoll {
  id      String     @id @default(uuid())
  topicId String     @unique
  topic   ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  question String
  /// Можно ли отметить несколько вариантов. Для «какую модель взяли»
  /// нужен один ответ, для «что менял по гарантии» — сразу несколько.
  multiple Boolean @default(false)

  /// Срок голосования. Пустой — бессрочно: обсуждение модели живёт
  /// годами, и закрывать такой опрос по календарю незачем.
  closesAt DateTime?

  createdAt DateTime @default(now())

  options ForumPollOption[]
  votes   ForumPollVote[]
}

/// Вариант ответа.
///
/// Счётчик голосов хранится полем, а не считается запросом: страница темы
/// открывается на каждый заход, и COUNT по всем голосам при живом опросе
/// становится самым дорогим запросом страницы.
model ForumPollOption {
  id     String    @id @default(uuid())
  pollId String
  poll   ForumPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  text     String
  position Int @default(0)
  votes    Int @default(0)

  ballots ForumPollVote[]

  @@index([pollId, position])
}

/// Голос участника.
///
/// Ограничение уникальности стоит в базе, а не в проверке кода: два
/// нажатия подряд с телефона уходят двумя запросами одновременно, и
/// проверка «уже голосовал» пропустит оба.
model ForumPollVote {
  id       String          @id @default(uuid())
  pollId   String
  poll     ForumPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  option   ForumPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation("ForumPollVoter", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([optionId, userId])
  @@index([pollId, userId])
}

/// Публикация объявления в чате сети.
///
/// Продвижение в чатах отличается от продвижения в каталоге тем, что
/// оставляет следы вне площадки: пост в чужой ленте и закреп, который
/// занимает единственное место закрепа в группе. Поэтому каждая
/// публикация записывается — иначе по истечении срока нечем снять
/// закреп и удалить сообщение.
model ChatPromotionPost {
  id      String @id @default(uuid())
  orderId String
  order   PromotionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Идентификатор чата: строка, потому что Telegram отдаёт большие числа.
  chatId String
  /// Идентификатор сообщения в чате — по нему снимается закреп и удаление.
  messageId Int
  /// Закреплён ли пост сейчас. В группе закреп один, поэтому новый
  /// вытесняет прежний, и это поле показывает, чей закреп действует.
  pinned Boolean @default(false)

  publishedAt DateTime  @default(now())
  /// Когда пост убран: по истечении срока или снятии объявления.
  removedAt   DateTime?

  @@index([orderId, publishedAt])
  @@index([chatId, publishedAt])
  @@index([removedAt])
}
