DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Telegram bot / Mini App
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_MODERATION_ENABLED="false"
TELEGRAM_MODERATION_CHAT_IDS=""
# Автоподборка выгодных лотов. Отправка идёт отдельным cron раз в 8 часов;
# коллектор аукционов сообщений не отправляет.
AUTOMART_AUCTION_TELEGRAM_CRON="off"
TELEGRAM_AUCTION_CHAT_IDS=""
TELEGRAM_AUCTION_POST_LIMIT="3"
TELEGRAM_AUCTION_POST_DELAY_MIN_MS="10000"
TELEGRAM_AUCTION_POST_DELAY_MAX_MS="15000"
TELEGRAM_AUCTION_MAX_AGE_HOURS="72"
TELEGRAM_AUCTION_SOURCE_FRESHNESS_HOURS="36"
TELEGRAM_AUCTION_MIN_COMPLETENESS_FIELDS="12"
TELEGRAM_AUCTION_MIN_FINAL_PRICE="1000000"
TELEGRAM_AUCTION_MIN_MEDIAN_RATIO="0.35"
TELEGRAM_AUCTION_MAX_PRICE_RATIO="0.82"
TELEGRAM_AUCTION_MAX_SERIOUS_DEFECTS="1"
TELEGRAM_AUCTION_MAX_INSPECTION_NOTES="30"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
TELEGRAM_MINI_APP_URL="https://example.ru/telegram"

# Public site address and server-to-server import of edited Telegram news.
# Keep NEWS_IMPORT_TOKEN private and set the same value in the news editor.
NEXT_PUBLIC_SITE_URL="https://example.ru"
NEWS_IMPORT_TOKEN=""
# Случайный длинный токен для импорта лотов аукционов. Без него импорт закрыт.
PARSER_TOKEN=""
# Исходящие HTTP CONNECT-прокси только для разрешённых публичных сборщиков.
# Формат: host:port:user:password, записи разделяются запятой или новой строкой.
# Значение хранится только в server env. Приложение жёстко ограничивает каждый
# адрес максимум 50 TCP-соединениями; безопасное значение по умолчанию — 4.
AUCTION_PROXY_POOL=""
AUCTION_PROXY_MAX_CONNECTIONS="4"
# Pull-based official/partner sources. Do not put tokens inside this JSON:
# tokenEnv points to a separate server-only variable. completeSnapshot may be
# enabled only when the provider guarantees that every active lot is returned.
# Example: [{"source":"DONGCHEDI","url":"https://partner.example/feed","tokenEnv":"DONGCHEDI_API_TOKEN","completeSnapshot":false}]
AUCTION_PARTNER_FEEDS_JSON="[]"
DONGCHEDI_API_TOKEN=""
AUTOHOME_API_TOKEN=""
CHE168_API_TOKEN=""
USS_API_TOKEN=""
IAAI_API_TOKEN=""
MOBILE_DE_API_USERNAME=""
MOBILE_DE_API_PASSWORD=""

# NVIDIA is optional and never replaces the deterministic contact policy.
# Enable only after installing valid server-side keys; failed AI checks fall
# back to the local blocker so obvious contacts cannot pass during an outage.
NVIDIA_KEYS=""
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"
NVIDIA_CHAT_MODERATION_ENABLED="false"
NVIDIA_MODERATION_MODEL="meta/llama-3.1-70b-instruct"

# Separate salt for privacy-safe IP analytics; NEXTAUTH_SECRET is the fallback.
ANALYTICS_HASH_SALT=""

# Карта АЗС: без ключа показываются справочные точки OpenStreetMap. Ключ
# партнёрского API включает статусы, цены и опубликованный ассортимент АЗС.
# Ключ хранится только на сервере и никогда не передаётся в браузер.
ZAPRAVKIN_API_KEY=""
ZAPRAVKIN_API_URL="https://api.zapravkin24.ru/v1"
# Контакт для корректной идентификации серверного поиска населённых пунктов.
FUEL_MAP_CONTACT_EMAIL=""

# Скрейпер АЗС и цен (ГдеБЕНЗ и другие открытые источники).
# Исходящие HTTP CONNECT-прокси с ротацией. Формат host:port:user:password,
# записи разделяются запятой или новой строкой. Значение хранится только в
# server env. Пул может быть пустым — тогда запросы идут напрямую.
#
# Ограничения типичного shared-провайдера (учитываются в коде):
#   - 50 TCP-соединений на клиента (это не число IP и не число потоков);
#     одна вкладка приложения может занимать 12-20 TCP, поэтому скрейпер
#     держит 1-2 соединения на запрос и не параллелит сверх лимита.
#   - перезагрузка адреса каждые 2 минуты, обрыв на смену IP 3-6 секунд;
#     при превышении лимита прокси не работает, пока не сброшены соединения.
#   - сброс TCP — только полное пересоздание подключения с паузой 10-15 сек.
# Соединения намеренно не держатся keep-alive, а при обрыве делается пауза
# и повтор с другого адреса (или напрямую в последнюю очередь).
FUEL_SCRAPER_PROXY_POOL=""
# Предел параллельных соединений на один адрес прокси (по умолчанию 2;
# под 50 TCP хватает с запасом).
FUEL_SCRAPER_MAX_CONNECTIONS="2"
# 2ГИС: официальный ключ Catalog API. Без ключа сбор 2ГИС пропускается.
# Можно также задать публичный ключ из браузерной сессии 2ГИС (менее стабилен).
TWOGIS_API_KEY=""
TWOGIS_PUBLIC_KEY=""

# Email verification (Resend). Use an authenticated sender address on your domain.
RESEND_API_KEY=""
EMAIL_FROM="Авторынок <noreply@example.ru>"
DELIVERY_DOCUMENTS_PATH=""
MESSAGE_ATTACHMENTS_PATH=""
STRIPE_SECRET_KEY=""

# ЮKassa — приём платежей российскими картами (продвижение объявлений).
# Регистрация: yookassa.ru -> подключить магазин (нужен ИП или юрлицо).
# shopId и секретный ключ — в личном кабинете ЮKassa, раздел «Интеграция».
# Адрес для уведомлений там же: https://lewheel.ru/api/payment/yookassa-webhook
# (событие payment.succeeded и payment.canceled).
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
